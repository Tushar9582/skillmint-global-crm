# Keep all passwords, tokens and keys private. Never commit a filled .env.
DATABASE_URL=postgres://skillmint:skillmint_local_password@localhost:5432/skillmint
APP_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=7

# Optional temporary Netlify Demo/Staging deployment. Configure on a separate
# Netlify site with no DATABASE_URL or NETLIFY_DATABASE_URL. Never enable on the
# production CRM site. Generate the hash with `npm run demo:hash-password`.
DEMO_MODE=false
DEMO_DATA_ISOLATED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD_HASH=
DEMO_SESSION_SECRET=

# Seed the first Admin exactly once: npm run db:seed
ADMIN_NAME=SkillMint Admin
ADMIN_EMAIL=admin@skillmintglobal.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
ORG_NAME=SkillMint Global

# local works for development; use spaces or s3 for cloud deployments.
STORAGE_DRIVER=local
STORAGE_BUCKET=skillmint-resumes
STORAGE_REGION=blr1
STORAGE_ENDPOINT=https://blr1.digitaloceanspaces.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# A configured clamd service is REQUIRED for production resume uploads.
# Development without clamd skips antivirus scanning; do not use that mode publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Do not set NODE_ENV here. Next.js sets it appropriately for dev/build/start.
