# SkillMint CRM production environment TEMPLATE only. Never commit actual secrets.
# Add these as Netlify server-side Environment Variables.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
APP_ORIGIN=https://skillmintcrm.netlify.app
SESSION_TTL_DAYS=7
DB_POOL_MAX=3

# All demo flags must be false for real authentication and shared data.
DEMO_MODE=false
DEMO_DATA_ISOLATED=false
DEMO_PUBLIC_PREVIEW=false

# Supabase private S3-compatible bucket, created in Supabase Storage.
STORAGE_DRIVER=supabase
STORAGE_BUCKET=skillmint-resumes
STORAGE_REGION=ap-northeast-1
STORAGE_ENDPOINT=https://nozhoxwloatjibejxker.storage.supabase.co/storage/v1/s3
# Create under Supabase Storage > S3 Configuration; keep server-side only.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Production resume uploads require a reachable ClamAV scanner.
CLAMAV_HOST=
CLAMAV_PORT=3310

# AI editing is optional and has its own paid API charges.
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-4o-mini
